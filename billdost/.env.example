# BillDost environment variables. Copy to .env.local and fill in real values.
# Never commit .env.local. Every variable the code reads is listed here.

# --- Supabase (required) ---
# Project URL: Supabase dashboard, Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key: safe to expose, data is protected by RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI chatbot (required for /api/chat) ---
# Read implicitly by the @ai-sdk/google provider. Get one at Google AI Studio.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- App URLs ---
# Public base URL of this app, used to build links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Port the Next.js server listens on in production (dev defaults to 3000).
PORT=3000
# Set by the framework/host: development, production or test. Listed for completeness.
NODE_ENV=development

# --- WhatsApp Cloud API (official, Stage 2) ---
# Server only. The Meta account, number and template setup happens with
# Chethan after the app is ready; until these are set, WhatsApp sends
# report Not Connected honestly and the app falls back to share options.
# Access token from Meta App Dashboard (WhatsApp, API Setup).
WHATSAPP_CLOUD_API_TOKEN=
# BillDost shared sending number's Phone Number ID (per-shop ids live in
# the whatsapp_connections table and win over this when connected).
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID for the shared number.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Random string you set in the Meta webhook configuration screen.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret, used to verify webhook POST signatures.
WHATSAPP_APP_SECRET=
# Approved utility template names (defaults shown).
WHATSAPP_TEMPLATE_INVOICE=billdost_invoice_v1
WHATSAPP_TEMPLATE_TEST=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
