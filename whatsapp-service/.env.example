# whatsapp-service environment variables (legacy whatsapp-web.js service,
# replaced by the Meta Cloud API in Stage 2). Copy to .env and fill in.

# Port the service listens on. The app expects it at this port via
# NEXT_PUBLIC_WHATSAPP_SERVICE_URL.
PORT=3001
# Optional: path to a Chrome/Chromium executable for Puppeteer.
# Leave unset to use the bundled Chromium.
PUPPETEER_EXECUTABLE_PATH=
