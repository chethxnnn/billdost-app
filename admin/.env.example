# BillDost Admin Portal: environment variables.
# Copy to .env.local for local development. The SAME Supabase project
# as the shop app (billdost/). See admin/README.md.

# Supabase project (shared with the shop app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC, never commit a real value.
# This key can read and write every shop's data; it exists only in the
# portal server's environment.
SUPABASE_SERVICE_ROLE_KEY=

# Public URLs, used to build links
NEXT_PUBLIC_SHOP_APP_URL=https://app.billdost.in
NEXT_PUBLIC_ADMIN_URL=https://admin.billdost.in
NEXT_PUBLIC_LANDING_URL=https://billdost.in

# WhatsApp Cloud API (platform sending identity, same Meta app as the
# shop app). When these are absent the portal shows honest
# not-connected states and activation links are copied manually.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_ACTIVATION=billdost_activation_v1
WHATSAPP_TEMPLATE_LANGUAGE=en_US
